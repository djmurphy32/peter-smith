{
  "name": "Peter's Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "root",
  "features": {
    "ghcr.io/devcontainers/features/git:1.3.8": {},
    "ghcr.io/nils-geistmann/devcontainers-features/zsh:0.0.8": {},
    "ghcr.io/devcontainers-community/features/deno:1.2.2": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "postStartCommand": "gh extension install github/gh-actions-lock && pnpm i && pnpx netlify login",
  "customizations": {
    "vscode": {
      "extensions": [
        "vue.volar",
        "vitest.explorer",
        "kingwl.vscode-vitest-runnerp",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "streetsidesoftware.code-spell-checker"
      ],
      "uninstalled": ["denoland.vscode-deno"]
    }
  },
  "forwardPorts": [3005]
}
